NODE_ENV=development
PORT=4000
APP_ORIGINS=http://localhost:3000,http://localhost:3001
# Local MongoDB or compose.yaml. Atlas example:
# MONGODB_URI=mongodb+srv://USERNAME:URL_ENCODED_PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=elementry
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=commerce:mongo:dev:
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SESSION_TTL_SECONDS=86400
SESSION_ABSOLUTE_TTL_SECONDS=604800
COOKIE_SAME_SITE=lax
# Trust no proxy by default. Configure exact ingress CIDRs in production, never '*'.
# Example: TRUST_PROXY=loopback,10.10.0.0/16
TRUST_PROXY=
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
CACHE_TTL_SECONDS=60
LOG_LEVEL=info
