# Render backend, also the default for Vercel builds when this variable is omitted.
# For a local backend, override with http://localhost:4000/api/v1.
NEXT_PUBLIC_API_URL=https://elementry-media.onrender.com/api/v1
# Optional on Vercel: defaults to the project's production domain, then deployment domain.
# Set explicitly to your canonical HTTPS frontend URL if system variables are disabled.
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Enable only after implementing the contracts in docs/api-contracts.md.
NEXT_PUBLIC_COMMERCE_API_ENABLED=false
NEXT_PUBLIC_SEARCH_API_ENABLED=false
NEXT_PUBLIC_ADMIN_API_ENABLED=false
NEXT_PUBLIC_PASSWORD_RECOVERY_ENABLED=false
# Business WhatsApp number including country code, digits only (no + or spaces).
NEXT_PUBLIC_WHATSAPP_NUMBER=9015747301
