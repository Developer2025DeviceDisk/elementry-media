{
  "name": "elementry-commerce-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "catalog:sync": "node scripts/sync-catalog-content.cjs",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
