    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "eslint": "^9.35.0",
    "@eslint/js": "^9.39.0",
    "typescript-eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.6.0",
